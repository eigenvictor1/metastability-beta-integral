{
  "name": "mixed",
  "defaults": {
    "scan": {"y": {"logspace": [-1.3, 0.544, 60]}, "M": {"logspace": [2.3010299956639812, 7, 60]}},
    "links": {"y": "all"},
    "benchmarks": [{"y": 0.5, "M": 1e3}, {"y": 0.5, "M": 1e6}],
    "run": {"betas": "pyrate", "plots": true, "trace_range": [1e-3, 1e3], "y_label": "$y$"},
    "trs": {"M": 1e3, "samples": 1500, "range": [0, 1.5]}
  },
  "models": [
    {"name": "N", "fields": ["(1,1,0)"], "include_sm_mixing": true, "exclude": ["yF1L1", "yF1L2"]},
    {"name": "Sigma", "fields": ["(1,3,0)"], "include_sm_mixing": true, "exclude": ["yF1L1", "yF1L2"]},
    {"name": "E", "fields": ["(1,1,-1)", "(1,1,1)"], "include_sm_mixing": true, "exclude": ["yF2L1c", "yF2L2c"]},
    {"name": "Delta1", "fields": ["(1,2,-1/2)", "(1,2,1/2)"], "include_sm_mixing": true, "exclude": ["yF1ec1c", "yF1ec2c"]},
    {"name": "Delta3", "fields": ["(1,2,-3/2)", "(1,2,3/2)"], "include_sm_mixing": true, "exclude": ["yF1ec1", "yF1ec2"]},
    {"name": "Sigma1", "fields": ["(1,3,-1)", "(1,3,1)"], "include_sm_mixing": true, "exclude": ["yF2L1c", "yF2L2c"]},
    {"name": "D", "fields": ["(3,1,-1/3)", "(3b,1,1/3)"], "include_sm_mixing": true, "exclude": ["yF2Q1c", "yF2Q2c"]},
    {"name": "U", "fields": ["(3,1,2/3)", "(3b,1,-2/3)"], "include_sm_mixing": true, "exclude": ["yF2Q1", "yF2Q2"]},
    {"name": "Q5", "fields": ["(3,2,-5/6)", "(3b,2,5/6)"], "include_sm_mixing": true, "exclude": ["yF1dc1", "yF1dc2"]},
    {"name": "Q1", "fields": ["(3,2,1/6)", "(3b,2,-1/6)"], "include_sm_mixing": true, "exclude": ["yF1uc1", "yF1uc2", "yF1dc1c", "yF1dc2c"]},
    {"name": "Q7", "fields": ["(3,2,7/6)", "(3b,2,-7/6)"], "include_sm_mixing": true, "exclude": ["yF1uc1c", "yF1uc2c"]},
    {"name": "T1", "fields": ["(3,3,-1/3)", "(3b,3,1/3)"], "include_sm_mixing": true, "exclude": ["yF2Q1c", "yF2Q2c"]},
    {"name": "T2", "fields": ["(3,3,2/3)", "(3b,3,-2/3)"], "include_sm_mixing": true, "exclude": ["yF2Q1", "yF2Q2"]}
  ]
}
